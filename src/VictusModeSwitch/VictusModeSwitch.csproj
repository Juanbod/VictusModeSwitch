<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VictusModeSwitch</AssemblyName>
    <RootNamespace>VictusModeSwitch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.4.1</Version>
    <Product>Victus Mode Switch</Product>
    <Description>Lightweight performance mode switcher for supported HP Victus laptops.</Description>
    <Authors>Juanbod and contributors</Authors>
    <RepositoryUrl>https://github.com/Juanbod/VictusModeSwitch</RepositoryUrl>
    <ApplicationIcon>..\..\assets\VictusModeSwitch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VictusModeSwitch.Tests" />
  </ItemGroup>

</Project>
